# Copy to backend/.env (gitignored) and fill in. docker-compose.yml forwards only the
# variables it lists under each service; anything else here is ignored.
# Full reference: RUNNING.md §5. Generate random values with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Required for Docker Compose (Spring refuses to start without real values) ──
JWT_SECRET=
CEVIEW_ATTRIBUTION_IP_HASH_SALT=

# ── AI and data keys (the stack starts without them; the features answer 503) ──
# Captions, creative direction, compliance audit, reports (fastapi-sbert).
GROQ_API_KEY=
# Market Radar trends (fastapi-transformer).
SERPAPI_KEY=
# Optional read-only token: E5 model download and HuggingFace Spaces.
HF_TOKEN=
HF_SPACE_ID=JamJamzz/ceview_sbert
# Optional model overrides (Groq retires models periodically).
# GROQ_MODEL=openai/gpt-oss-120b
# OMCS_VISION_MODEL=qwen/qwen3.8-27b
# Forecaster: stub (placeholder, no keys) | bilstm (HF Space) | groq (needs GROQ_API_KEY).
FORECAST_ENGINE=stub
# Nightly market-data refresh at 00:00 UTC; spends SerpApi searches. false stops it.
# INGESTION_ENABLED=true

# ── Email verification + password reset ──
# 'log' prints each 6-digit code to the spring-boot log and sends nothing (local dev).
# For real mail: EMAIL_PROVIDER=resend, a Resend key, and a sender on a verified domain,
# e.g. EMAIL_FROM=CeView <no-reply@yourdomain.com>. See docs/DEPLOY_RENDER.md.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=

# ── Google sign-in and phone verification (optional) ──
# Firebase service-account JSON on one line. Blank: POST /api/auth/google returns 503.
# See RUNNING.md §6.
FIREBASE_CREDENTIALS_JSON=

# ── Ad-account connections (optional) — see AD_PLATFORM_SETUP.md ──
META_APP_ID=
META_APP_SECRET=
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOKEN_ENCRYPTION_KEY=
# Your tunnel URL, no trailing slash (AD_PLATFORM_SETUP.md §4).
OAUTH_REDIRECT_BASE_URL=
# FRONTEND_BASE_URL=http://localhost:3001

# ── Overrides with working defaults (leave commented unless you need them) ──
# Keep http://localhost:3012 in the list or Playwright fails CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3012,http://localhost:5173
# Public origin of the /r/{slug} redirect; it ends up in live ads.
# CEVIEW_ATTRIBUTION_BASE_URL=http://localhost:8080

# ── Playwright e2e only (RUNNING.md §8) ──
# true exposes /api/test-support/email-codes/latest; refused together with EMAIL_PROVIDER=resend.
CEVIEW_TEST_SUPPORT_ENABLED=false
# Per-IP cap on auth emails per 15 minutes; use 1000 for e2e runs.
# CEVIEW_AUTH_RATE_LIMIT_MAX_REQUESTS=10
