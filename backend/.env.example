GROQ_API_KEY=
HF_TOKEN=
HF_SPACE_ID=JamJamzz/ceview_sbert
WANDB_API_KEY=
WANDB_PROJECT=ceview-demand-forecast
ENABLE_WANDB=true
# Required for Docker Compose (Postgres profile): Spring Boot refuses to start
# without real values. e.g. `openssl rand -hex 32` / `openssl rand -hex 16`.
JWT_SECRET=replace-with-32+chars-of-real-secret-in-prod
CEVIEW_ATTRIBUTION_IP_HASH_SALT=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,http://localhost:3002
# Public origin embedded in attribution links placed in paid ads.
CEVIEW_ATTRIBUTION_BASE_URL=
# Salt for hashing traveller IPs in link attribution click capture.
CEVIEW_ATTRIBUTION_IP_HASH_SALT=
# Full Firebase service-account JSON as a single-line string — enables
# "Continue with Google". Leave blank to leave Google sign-in disabled
# (POST /api/v1/auth/google returns 503). See RUNNING.md §6.
FIREBASE_CREDENTIALS_JSON=
