@startuml

skinparam defaultFontSize 12
skinparam PageOrientation portrait
skinparam linetype ortho
skinparam EntityBorderColor #444444
skinparam EntityBackgroundColor white
skinparam ArrowColor #444444
skinparam shadowing false
hide methods
hide stereotypes

' ── Auth / Profile anchors (Module 1 stubs) ──────────────────────────────

entity tbl_msme_operator {
    * operator_id : UUID <<PK>>
}

entity tbl_business_profile {
    * business_profile_id : UUID <<PK>>
    --
    user_id : UUID <<FK>>
    business_name : VARCHAR
    categories_json : TEXT
}

' ── Submodule 2.1 — Market Signal Records ────────────────────────────────

entity tbl_market_signal_record {
    * signal_record_id : UUID <<PK>>
    --
    business_profile_id : UUID <<FK>>
    target_market : VARCHAR
    trend_index : FLOAT
    forex_rate : FLOAT
    gdp_growth : FLOAT
    seasonality_score : FLOAT
    rolling_average : FLOAT
    rolling_average_7d : FLOAT
    rolling_average_30d : FLOAT
    rolling_std_dev : FLOAT
    yoy_ratio : FLOAT
    spike_indicator : BOOLEAN
    aggregated_at : TIMESTAMPTZ
}

entity tbl_ingestion_job_log {
    * job_log_id : UUID <<PK>>
    --
    job_name : VARCHAR
    status : VARCHAR
    markets_processed : INT
    records_ingested : INT
    error_message : TEXT
    started_at : TIMESTAMPTZ
    completed_at : TIMESTAMPTZ
}

entity tbl_trend_fetch_job {
    * job_id : UUID <<PK>>
    --
    category : VARCHAR
    market : VARCHAR
    status : VARCHAR
    week_of : VARCHAR(10)
    attempt_count : INT
    max_attempts : INT
    trend_index : FLOAT
    spike_indicator : BOOLEAN
    yoy_ratio : FLOAT
    seasonality_score : FLOAT
    source : VARCHAR
    last_error : TEXT
}

note bottom of tbl_trend_fetch_job
  UNIQUE(category, market, week_of)
  status: PENDING -> IN_PROGRESS
          -> SUCCESS | FAILED
end note

entity tbl_market_economic_trend {
    * trend_id : UUID <<PK>>
    --
    market : VARCHAR
    gdp_trend_json : TEXT
    forex_trend_json : TEXT
    gdp_latest : FLOAT
    forex_latest : FLOAT
    currency_code : VARCHAR
    gdp_points : INT
    forex_points : INT
    fetched_at : TIMESTAMPTZ
}

' ── Submodule 2.2 — Forecasting & Scoring ────────────────────────────────

entity tbl_forecast_result {
    * forecast_result_id : UUID <<PK>>
    --
    business_profile_id : UUID <<FK>>
    target_market : VARCHAR
    predicted_demand : FLOAT
    forecast_confidence : FLOAT
    mape_score : FLOAT
    mae : FLOAT
    rmse : FLOAT
    forecast_horizon_weeks : INT
    weekly_forecasts_json : TEXT
    generated_at : TIMESTAMPTZ
}

entity tbl_market_score {
    * market_score_id : UUID <<PK>>
    --
    forecast_result_id : UUID <<FK>>
    market_score : FLOAT
    seasonality_score : FLOAT
    spike_indicator : BOOLEAN
    gdp_per_capita_growth : FLOAT
    forex_vs_php : FLOAT
    historical_arrivals : INT
    market_rank : INT
    evaluated_at : TIMESTAMPTZ
}

entity tbl_demand_alert {
    * demand_alert_id : UUID <<PK>>
    --
    market_score_id : UUID <<FK>>
    alert_level : VARCHAR
    alert_message : TEXT
    window_open_date : TIMESTAMPTZ
    alert_date : TIMESTAMPTZ
    trend : VARCHAR
    is_read : BOOLEAN
}

' ── Relationships ──────────────────────────────────────────────────────────

tbl_msme_operator     ||--o{ tbl_business_profile        : "owns"
tbl_business_profile  ||--o{ tbl_market_signal_record    : "has signal records"
tbl_business_profile  ||--o{ tbl_forecast_result         : "has forecast results"
tbl_forecast_result   ||--o{ tbl_market_score            : "scored by"
tbl_market_score      ||--o{ tbl_demand_alert            : "triggers alerts"

@enduml
