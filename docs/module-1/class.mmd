classDiagram
    %% ═══════════════════════════════════════════════════════════
    %% FRONTEND — Interfaces & Components
    %% ═══════════════════════════════════════════════════════════

    class ProfileData {
        <<interface>>
        +businessProfileId: string | null
        +businessName: string
        +categories: string[]
        +coreServices: string[]
        +description: string
        +uvp: string
        +imagePreview: string | null
        +uniquenessScore: number | null
    }

    class ProfileSetters {
        <<interface>>
        +setBusinessProfileId: Dispatch
        +setBusinessName: Dispatch
        +setCategories: Dispatch
        +setCoreServices: Dispatch
        +setDescription: Dispatch
        +setUvp: Dispatch
        +setImagePreview: Dispatch
        +setUniquenessScore: Dispatch
    }

    class BusinessProfileDTO {
        <<interface>>
        +businessProfileId: string | null
        +businessName: string
        +categories: string[]
        +coreServices: string[]
        +description: string
        +uvp: string
        +imagePreview: string | null
        +uniquenessScore: number | null
    }

    class CategoryAllocation {
        <<interface>>
        +name: string
        +percentage: number
    }

    class UniquenessPayloadDTO {
        <<interface>>
        +businessName: string
        +coreServices: string[]
        +description: string
        +uvp: string
    }

    class UniquenessResultDTO {
        <<interface>>
        +overallScore: number
        +semanticsScore: number
        +categoryScore: number
        +descriptionFeedback: string
        +categoryFeedback: string
    }

    class DetailedCalibrationResultDTO {
        <<interface>>
        +overallScore: number
        +semanticsScore: number
        +categoryScore: number
        +descriptionFeedback: string
        +categoryFeedback: string
    }

    class App {
        <<component>>
        -activeTab: string
        -ProfileData state fields
        +useEffect() loadProfile on mount
        +render() route to views
    }

    class apiClient {
        <<service>>
        +loadProfile(operatorId) BusinessProfileDTO
        +saveProfile(operatorId, body) BusinessProfileDTO
        +classifyAnalyze(body) CategoryAllocation[]
        +classifyUniqueness(body) UniquenessResultDTO
        +generateKeywords(body) string[]
    }

    class identity {
        <<service>>
        +OPERATOR_ID: string
    }

    class UniquenessCalibrationView {
        <<view>>
        -payload: UniquenessPayloadDTO
        -categories: CategoryAllocation[]
        -calibrationResult: DetailedCalibrationResultDTO | null
        +handleAnalyzeRequest()
        +handleComputeRequest()
        +handleConfirmProfile()
    }

    class BusinessProfileView {
        <<view>>
        -keywords: string[]
        -isEditModalOpen: boolean
        -isSaved: boolean
        -saveError: string | null
        +handleGenerateKeywords()
        +handleSaveProfile()
    }

    class UniquenessCalibrationForm {
        <<module>>
        -payload: UniquenessPayloadDTO
        -isFormValid: boolean
        +onAnalyze()
        +onCompute()
    }

    class InferredCategoryBoard {
        <<module>>
        -categories: CategoryAllocation[]
        -totalPercentage: number
        -isValid: boolean
        +onChangeCategory(name, pct)
    }

    class CalibrationResultsDashboard {
        <<module>>
        -isAwaiting: boolean
        -result: DetailedCalibrationResultDTO | null
        +onConfirm()
    }

    class AdjustableCategoryItem {
        <<composite>>
        -label: string
        -percentage: number
        +onChange(newPct)
    }

    class ActionableScoreCard {
        <<composite>>
        -title: string
        -score: number
        -color: string
        -description: string
        -feedbackText: string
    }

    class OverallScoreCard {
        <<composite>>
        -score: number
    }

    class ComputeUniquenessButton {
        <<composite>>
        -isValid: boolean
        -isLoading: boolean
        +onSubmit()
    }

    class DynamicListManager {
        <<composite>>
        -items: string[]
        +onChange(items)
    }

    class TextField {
        <<composite>>
        -label: string
        -value: string
        +onChange(val)
    }

    class TextAreaField {
        <<composite>>
        -label: string
        -value: string
        -guideText: string
        +onChange(val)
    }

    class ValidationBanner {
        <<composite>>
        -isValid: boolean
    }

    class ActionTag {
        <<base>>
        -label: string
        -isActive: boolean
        +onClick()
        +onRemove()
    }

    class PrimaryButton {
        <<base>>
        -isLoading: boolean
        -fullWidth: boolean
        -disabled: boolean
    }

    class StatTypography {
        <<base>>
        -value: number
        -color: string
        -sizeClass: string
    }

    %% ═══════════════════════════════════════════════════════════
    %% BACKEND — Classes & Records
    %% ═══════════════════════════════════════════════════════════

    class BusinessProfileEntity {
        <<entity>>
        -businessProfileId: UUID
        -userId: UUID
        -businessName: String
        -businessDescription: String
        -uvp: String
        -coreServices: String
        -imageUrl: String
        -categories: String
        -confidenceScore: Float
        -uniquenessScore: Float
        -createdAt: OffsetDateTime
        -updatedAt: OffsetDateTime
        +coreServicesList() List~String~
        +setCoreServicesList(List~String~)
        +categoriesList() List~String~
        +setCategoriesList(List~String~)
    }

    class BusinessProfileDto {
        <<record>>
        +businessProfileId: UUID
        +businessName: String
        +categories: List~String~
        +coreServices: List~String~
        +description: String
        +uvp: String
        +imagePreview: String
        +uniquenessScore: Float
    }

    class AnalyzeRequest {
        <<record>>
        +businessName: String
        +coreServices: List~String~
        +description: String
        +uvp: String
    }

    class AnalyzeResponse {
        <<record>>
        +categories: List~CategoryAllocationRecord~
    }

    class CategoryAllocationRecord {
        <<record>>
        +name: String
        +percentage: double
    }

    class UniquenessRequest {
        <<record>>
        +businessName: String
        +categories: List~String~
        +coreServices: List~String~
        +description: String
        +uvp: String
    }

    class UniquenessResponse {
        <<record>>
        +overallScore: int
        +semanticsScore: int
        +categoryScore: int
        +descriptionFeedback: String
        +categoryFeedback: String
    }

    class KeywordRequest {
        <<record>>
        +businessName: String
        +description: String
        +category: String
    }

    class BusinessProfileRepository {
        <<interface>>
        +findFirstByUserId(UUID) Optional~BusinessProfileEntity~
        +findById(UUID) Optional~BusinessProfileEntity~
        +save(BusinessProfileEntity)
    }

    class BusinessProfileController {
        <<controller>>
        -repo: BusinessProfileRepository
        -ai: AIInferenceGatewayService
        +get(operatorId) BusinessProfileDto
        +save(BusinessProfileDto, operatorId) BusinessProfileDto
        +keywords(KeywordRequest) List~String~
        -toDto(BusinessProfileEntity) BusinessProfileDto
        -emptyDto() BusinessProfileDto
    }

    class ClassificationController {
        <<controller>>
        -ai: AIInferenceGatewayService
        +analyze(AnalyzeRequest) AnalyzeResponse
        +uniqueness(UniquenessRequest) UniquenessResponse
    }

    class AIInferenceGatewayService {
        <<service>>
        -client: WebClient
        -timeout: Duration
        +classifyCategories(Map) Map
        +computeUniqueness(Map) Map
        +generateKeywords(Map) List~String~
    }

    %% ═══════════════════════════════════════════════════════════
    %% RELATIONSHIPS — Frontend
    %% ═══════════════════════════════════════════════════════════

    App *-- ProfileData : holds
    App *-- ProfileSetters : holds
    App --> UniquenessCalibrationView : renders with profile+setters
    App --> BusinessProfileView : renders with profile+setters
    App --> apiClient : loadProfile on mount

    UniquenessCalibrationView --> UniquenessCalibrationForm : renders
    UniquenessCalibrationView --> InferredCategoryBoard : renders after analyze
    UniquenessCalibrationView --> CalibrationResultsDashboard : renders
    UniquenessCalibrationView --> apiClient : classifyAnalyze, classifyUniqueness, saveProfile
    UniquenessCalibrationView --> identity : OPERATOR_ID
    UniquenessCalibrationView ..> CategoryAllocation : uses
    UniquenessCalibrationView ..> UniquenessPayloadDTO : uses
    UniquenessCalibrationView ..> DetailedCalibrationResultDTO : uses

    BusinessProfileView --> apiClient : generateKeywords, saveProfile
    BusinessProfileView --> identity : OPERATOR_ID
    BusinessProfileView ..> ProfileData : reads

    UniquenessCalibrationForm --> TextField : renders
    UniquenessCalibrationForm --> TextAreaField : renders
    UniquenessCalibrationForm --> DynamicListManager : renders
    UniquenessCalibrationForm --> ValidationBanner : renders
    UniquenessCalibrationForm --> InferredCategoryBoard : renders (post-analyze)
    UniquenessCalibrationForm ..> UniquenessPayloadDTO : uses

    InferredCategoryBoard --> AdjustableCategoryItem : renders per category
    CalibrationResultsDashboard --> OverallScoreCard : renders
    CalibrationResultsDashboard --> ActionableScoreCard : renders x2
    CalibrationResultsDashboard ..> DetailedCalibrationResultDTO : uses

    ComputeUniquenessButton --> PrimaryButton : wraps
    ActionableScoreCard --> StatTypography : renders score
    OverallScoreCard --> StatTypography : renders score

    apiClient ..> BusinessProfileDTO : produces/consumes
    apiClient ..> CategoryAllocation : produces
    apiClient ..> UniquenessResultDTO : produces

    UniquenessResultDTO --|> DetailedCalibrationResultDTO : same shape

    %% ═══════════════════════════════════════════════════════════
    %% RELATIONSHIPS — Backend
    %% ═══════════════════════════════════════════════════════════

    BusinessProfileController --> BusinessProfileRepository : uses
    BusinessProfileController --> AIInferenceGatewayService : generateKeywords
    BusinessProfileController ..> BusinessProfileDto : produces/consumes
    BusinessProfileController ..> BusinessProfileEntity : maps to/from
    BusinessProfileController ..> KeywordRequest : consumes

    ClassificationController --> AIInferenceGatewayService : classifyCategories, computeUniqueness
    ClassificationController ..> AnalyzeRequest : consumes
    ClassificationController ..> AnalyzeResponse : produces
    ClassificationController ..> UniquenessRequest : consumes
    ClassificationController ..> UniquenessResponse : produces

    AnalyzeResponse *-- CategoryAllocationRecord : contains list
    BusinessProfileRepository ..> BusinessProfileEntity : manages

    %% ═══════════════════════════════════════════════════════════
    %% CROSS-LAYER CONTRACT
    %% ═══════════════════════════════════════════════════════════

    BusinessProfileDto .. BusinessProfileDTO : mirrors over HTTP
    CategoryAllocationRecord .. CategoryAllocation : mirrors over HTTP
    UniquenessResponse .. UniquenessResultDTO : mirrors over HTTP
