sequenceDiagram
    participant Client
    participant BPC as BusinessProfileController
    participant CC as ClassificationController
    participant AI as AIInferenceGatewayService
    participant repo as BusinessProfileRepository
    participant FP as FastAPI

    %% ── 1. Profile Load ─────────────────────────────────────────────────────
    Note over Client,FP: 1 · Profile Load

    Client->>BPC: GET /api/v1/business-profile?operatorId=…
    BPC->>repo: findFirstByUserId(operatorId)
    alt profile exists
        repo-->>BPC: BusinessProfileEntity
        BPC-->>Client: BusinessProfileDto (populated)
    else no record yet
        repo-->>BPC: empty
        BPC-->>Client: BusinessProfileDto (empty stub)
    end

    %% ── 2. Analyze Business Profile ─────────────────────────────────────────
    Note over Client,FP: 2 · Analyze Business Profile

    Client->>CC: POST /api/v1/classification/analyze
    Note right of Client: AnalyzeRequest {businessName, coreServices, description, uvp}
    CC->>AI: classifyCategories(payload)
    AI->>FP: POST /internal/classification/analyze
    FP-->>AI: {categories:[{name, percentage}]}
    AI-->>CC: Map~String,Object~
    CC-->>Client: AnalyzeResponse {categories: CategoryAllocationRecord[]}

    %% ── 3. Confirm & Persist Profile ────────────────────────────────────────
    Note over Client,FP: 3 · Confirm & Persist Profile

    Client->>BPC: PUT /api/v1/business-profile?operatorId=…
    Note right of Client: BusinessProfileDto {profileId, name, categories, services, desc, uvp, image, score}
    BPC->>BPC: upsert — setCategoriesList, setCoreServicesList
    BPC->>repo: save(BusinessProfileEntity)
    repo-->>BPC: saved entity
    BPC-->>Client: BusinessProfileDto (with persisted businessProfileId)

    %% ── 4. Generate SEO Keywords ─────────────────────────────────────────────
    Note over Client,FP: 4 · Generate SEO Keywords

    Client->>BPC: POST /api/v1/business-profile/keywords
    Note right of Client: KeywordRequest {businessName, description, category}
    BPC->>AI: generateKeywords(payload)
    AI->>FP: POST /internal/classification/keywords
    FP-->>AI: {keywords:[…]}
    AI-->>BPC: List~String~
    BPC-->>Client: List~String~

    %% ── 5. Edit Identity Save ────────────────────────────────────────────────
    Note over Client,FP: 5 · Edit Identity Save

    Client->>BPC: PUT /api/v1/business-profile?operatorId=…
    Note right of Client: full profile snapshot (background call)
    BPC->>BPC: upsert BusinessProfileEntity
    BPC->>repo: save(BusinessProfileEntity)
    alt save succeeds
        repo-->>BPC: saved entity
        BPC-->>Client: BusinessProfileDto
    else save fails
        BPC-->>Client: 5xx error
    end
