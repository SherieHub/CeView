sequenceDiagram
    participant Browser
    participant App
    participant UCView as UniquenessCalibrationView
    participant BPView as BusinessProfile
    participant AC as apiClient
    participant BPC as BusinessProfileController
    participant CC as ClassificationController
    participant AI as AIInferenceGatewayService
    participant FP as FastAPI

    %% ── 1. App Mount — Profile Load ─────────────────────────────────────────
    Note over Browser,FP: 1 · App Mount — Profile Load

    Browser->>App: render()
    App->>AC: loadProfile(OPERATOR_ID)
    AC->>BPC: GET /api/v1/business-profile?operatorId=…
    BPC->>BPC: repo.findFirstByUserId(operatorId)
    alt profile exists
        BPC-->>AC: BusinessProfileDto (populated)
    else no record yet
        BPC-->>AC: BusinessProfileDto (empty)
    end
    AC-->>App: BusinessProfileDTO
    App->>App: hydrate all ProfileData setters<br/>(id, name, categories, services, desc, uvp, image, score)

    %% ── 2. Analyze Business Profile ─────────────────────────────────────────
    Note over Browser,FP: 2 · Calibration Phase 1 — Analyze Business Profile

    Browser->>UCView: click "Analyze Business Profile"
    UCView->>AC: classifyAnalyze({businessName, coreServices, description, uvp})
    AC->>CC: POST /api/v1/classification/analyze
    CC->>AI: classifyCategories(payload)
    AI->>FP: POST /internal/classification/analyze
    FP-->>AI: {categories:[{name, percentage}]}
    AI-->>CC: Map<String,Object>
    CC-->>AC: AnalyzeResponse {categories: CategoryAllocation[]}
    AC-->>UCView: {categories: CategoryAllocation[]}
    UCView->>UCView: merge with BASE_CATEGORIES → setCategories
    UCView->>Browser: render InferredCategoryBoard (sliders)

    %% ── 3. Compute Uniqueness Score ──────────────────────────────────────────
    Note over Browser,FP: 3 · Calibration Phase 2 — Compute Uniqueness Score

    Browser->>UCView: adjust sliders → click "Compute Final Uniqueness Score"
    UCView->>AC: classifyUniqueness({businessName, categories(pct>0), coreServices, description, uvp})
    AC->>CC: POST /api/v1/classification/uniqueness
    CC->>AI: computeUniqueness(payload)
    AI->>FP: POST /internal/classification/uniqueness
    FP-->>AI: {overallScore, semanticsScore, categoryScore, descriptionFeedback, categoryFeedback}
    AI-->>CC: Map<String,Object>
    CC-->>AC: UniquenessResponse
    AC-->>UCView: UniquenessResultDTO
    UCView->>UCView: setCalibrationResult(result)
    UCView->>Browser: render CalibrationResultsDashboard (three score cards)

    %% ── 4. Confirm & Save Profile ────────────────────────────────────────────
    Note over Browser,FP: 4 · Confirm & Persist Profile

    Browser->>UCView: click "Confirm & Register Profile"
    UCView->>AC: saveProfile(OPERATOR_ID, {profileId, name, categories, services, desc, uvp, image, uniquenessScore})
    AC->>BPC: PUT /api/v1/business-profile?operatorId=…
    BPC->>BPC: upsert BusinessProfile (setCategoriesList, setCoreServicesList, …)
    BPC-->>AC: BusinessProfileDto (with persisted businessProfileId)
    AC-->>UCView: saved BusinessProfileDTO
    UCView->>App: update ProfileSetters (businessProfileId, categories, score, …)
    UCView->>Browser: navigate to 'profile' tab

    %% ── 5. Generate SEO Keywords ─────────────────────────────────────────────
    Note over Browser,FP: 5 · BusinessProfile — Generate SEO Keywords

    Browser->>BPView: click "Recalibrate" (keywords)
    BPView->>AC: generateKeywords({businessName, description, category: categories.join(", ")})
    AC->>BPC: POST /api/v1/business-profile/keywords
    BPC->>AI: generateKeywords(payload)
    AI->>FP: POST /internal/classification/keywords
    FP-->>AI: {keywords:[…]}
    AI-->>BPC: List<String>
    BPC-->>AC: string[]
    AC-->>BPView: string[]
    BPView->>BPView: setKeywords(generated)
    BPView->>Browser: render keyword chip list

    %% ── 6. Edit Identity Modal Save ──────────────────────────────────────────
    Note over Browser,FP: 6 · BusinessProfile — Edit Identity Save (optimistic)

    Browser->>BPView: click "Commit Profile Data"
    BPView->>BPView: optimistic update — apply all temp* setters immediately
    BPView->>Browser: close modal, show "Saved Successfully" banner
    BPView->>AC: saveProfile(OPERATOR_ID, {current state}) [background]
    AC->>BPC: PUT /api/v1/business-profile?operatorId=…
    alt save succeeds
        BPC-->>AC: BusinessProfileDto
        AC-->>BPView: patch businessProfileId + uniquenessScore
    else save fails
        AC-->>BPView: error
        BPView->>Browser: show "Changes saved locally. Backend sync failed." banner
    end
