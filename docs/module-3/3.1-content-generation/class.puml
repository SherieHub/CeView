@startuml
skinparam defaultFontSize 12
scale max 800 width
top to bottom direction
skinparam padding 2
skinparam linetype ortho

title 3.1 — Market-Localized Promotional Content Generation: Class / Component Structure

package "3.1 Market-Localized Promotional Content Generation" {

  package "React Frontend" #EEF2FF {
    class ContentStudioView {
      -content: ContentResponseDTO
      -activeTab: ContentPlatformId
      -approvedIndices: Record<platform, number>
      -approvedCaptions: Record<platform, string>
      -approvedMetadata: Record<platform, CaptionMetadata>
      +generateContent()
      +approveContent(platform)
    }
    class AIContentMatrixPanel {
      -options: string[]
      -optionNames: string[]
      -activeTab: ContentPlatformId
      -charLimit: number
      +renderPlatformTab(platform)
    }
    class CopywritingOptionCard {
      +index: number
      +text: string
      +optionName: string
      +charLimit: number
      +isApproved: boolean
      +onApprove()
      +onCopy()
      +onEdit()
    }
    class PlatformTab {
      +platform: string
      +isActive: boolean
    }
    class DistributionPanel {
      +channels: SocialChannel[]
      +renderChannelCards()
    }
  }

  package "Spring Boot" #E8F5E9 {
    class ContentController {
      +generate(req, profileId?): ContentResponseDto
      +approve(body, profileId): Map<approvedIds, market, count>
    }
    class ContentGenerationService {
      +generate(req, profileId): ContentResponseDto
      -buildForecastContext(profileId, market): Map
      -persistContent(profileId, market, dto): void
    }
    class ContentApprovalService {
      +approveForMarket(profileId, market): List<UUID>
      +hasApprovedContent(profileId, market): boolean
      +getApprovedCaptions(profileId, market): List<String>
    }
    class AIInferenceGatewayService {
      +generateCaption(payload): Map
    }
    class LocalizedPromotionalContent <<Entity>> {
      +contentId: UUID
      +businessProfileId: UUID
      +selectedMarket: String
      +platform: String
      +generatedCaption: TEXT
      +contentDirection: TEXT
      +hashtags: TEXT
      +cta: TEXT
      +toneSuggestion: TEXT
      +framework: String
      +source: String
      +approvalStatus: Boolean
      +generatedAt: OffsetDateTime
      +approvedAt: OffsetDateTime
    }
    interface LocalizedPromotionalContentRepository <<JPA>> {
      +findByBusinessProfileIdAndSelectedMarket...()
      +findByBusinessProfileIdAndApprovalStatusTrue()
      +save(entity)
    }
    class ContentGenerationLog <<Entity>> {
      +contentLogId: UUID
      +businessProfileId: UUID
      +generationStatus: String
      +diagnostics: TEXT
      +loggedAt: OffsetDateTime
    }
  }

  package "FastAPI (fastapi-sbert)" #FFFDE7 {
    class CaptionRouter {
      +POST /internal/generation/caption
    }
    class CaptionGenerationService {
      +caption_generation_service(input): dict
    }
    class CaptionGenerationAgent <<LangGraph>> {
      +analyze_services(state): state
      +generate_platform_captions(state): state
    }
    class CulturalResearchService {
      +research_market(market): dict
      -_MARKET_TEMPLATES: dict
    }
    class GeminiClient {
      +get_platform_guides(market): dict
    }
    class AgentLLMModel {
      -_instance: ChatGroq
      +get_llm(): ChatGroq
    }
  }

  package "DTOs / Models" #FFF3E0 {
    class CaptionInputClass {
      +business_name: str
      +business_description: str
      +business_uvp: str
      +business_services: List[str]
      +market_category: str
      +target_market: str
      +forecast_context: str
      +research_context: str
    }
    class SocialAgentState {
      +final_captions: Dict[platform, List]
      +source: str
    }
    class ContentResponseDto {
      +market: MarketHeaderDto
      +framework: String
      +captions: CaptionsDto
      +source: String
    }
    class CaptionsDto {
      +instagram: PlatformContentDto
      +tiktok: PlatformContentDto
      +facebook: PlatformContentDto
      +naver: PlatformContentDto
    }
    class PlatformContentDto {
      +options: List<String>
      +optionNames: List<String>
      +optionMetadata: List<CaptionMetadata>
      +guide: List<String>
    }
    class CaptionMetadata {
      +core_business_context: String
      +market_cultural_localization: String
      +psychological_elements: String
      +creative_tone_atmosphere: String
      +algorithmic_platform_architecture: String
    }
  }
}

ContentStudioView *-- AIContentMatrixPanel
ContentStudioView *-- DistributionPanel
AIContentMatrixPanel *-- "3" CopywritingOptionCard
AIContentMatrixPanel *-- "3" PlatformTab

ContentStudioView ..> ContentController : POST /api/v1/content/generate\nPOST /api/v1/content/approve

ContentController --> ContentGenerationService : generate()
ContentController --> ContentApprovalService : approveForMarket()
ContentGenerationService --> AIInferenceGatewayService : generateCaption()
ContentGenerationService --> LocalizedPromotionalContentRepository : save()
ContentApprovalService --> LocalizedPromotionalContentRepository : findBy... / save()

AIInferenceGatewayService ..> CaptionRouter : POST /internal/generation/caption

CaptionRouter --> CaptionGenerationService : caption_generation_service()
CaptionRouter --> GeminiClient : get_platform_guides()
CaptionGenerationService --> CaptionGenerationAgent : ainvoke(state)
CaptionGenerationAgent --> CulturalResearchService : research_market()
CaptionGenerationAgent --> AgentLLMModel : get_llm()

CaptionGenerationService ..> CaptionInputClass : consumes
CaptionGenerationAgent ..> SocialAgentState : reads / writes
ContentController ..> ContentResponseDto : returns
ContentResponseDto *-- CaptionsDto
CaptionsDto *-- "4" PlatformContentDto
PlatformContentDto *-- "3" CaptionMetadata
LocalizedPromotionalContentRepository --> LocalizedPromotionalContent : persists

' ── Stack packages top-to-bottom ──
"React Frontend" -[hidden]down-> "Spring Boot"
"Spring Boot" -[hidden]down-> "FastAPI (fastapi-sbert)"
"FastAPI (fastapi-sbert)" -[hidden]down-> "DTOs / Models"

@enduml
