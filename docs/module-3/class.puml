@startuml
skinparam defaultFontSize 12
scale max 800 width
top to bottom direction
skinparam padding 2
skinparam linetype ortho

title Module 3 — Content Studio: Class / Component Structure (3.1 + 3.2 + 3.3)

package "Module 3 — Content Studio" {

  package "React Frontend" #EEF2FF {
    class ContentStudioView {
      -content: ContentResponseDTO
      -creativeDirection: CreativeDirectionDTO
      -activeTab: ContentPlatformId
      -approvedIndices: Record<platform, number>
      -approvedCaptions: Record<platform, string>
      -stagedCaption: string
      -uploadedFile: File
      -imageDataUrl: string
      -auditOn: boolean
      -auditRunning: boolean
      -omcs: OmcsAuditResultDTO
      +generateContent()
      +approveContent(platform)
      +generateCreative(profileId, market)
      +approveCreative(profileId, market)
      +runOmcsAudit()
    }
    class AIContentMatrixPanel {
      +renderPlatformTab(platform)
    }
    class CopywritingOptionCard {
      +onApprove()
      +onCopy()
      +onEdit()
    }
    class PlatformTab
    class VisualDirectionBoard {
      -guide: string[]
    }
    class BlueprintStepItem
    class DistributionPanel
    class SmartOptimizationBoard {
      -auditOn: boolean
      -auditRunning: boolean
      -omcs: OmcsAuditResultDTO
      +onRunAudit()
      +onResetAudit()
    }
    class ComplianceGauge {
      +score: number
    }
    class MediaCaptionManager {
      +stagedCaption: string
      +onFileIngest(file)
    }
    class apiClient <<service>> {
      +generateContent()
      +approveContent()
      +generateCreative()
      +approveCreative()
      +analyzeOmcs()
    }
  }

  package "Spring Boot" #E8F5E9 {
    class ContentController {
      +generate(req, profileId?)
      +approve(body, profileId)
    }
    class CreativeDirectionController {
      +generate(profileId, market?)
      +approve(profileId, market?)
    }
    class ComplianceController {
      +omcsAnalyze(body): OmcsAuditResultDto
    }
    class ContentGenerationService
    class ContentApprovalService {
      +hasApprovedContent(profileId, market): boolean
      +getApprovedCaptions(profileId, market)
    }
    class CreativeDirectionService
    class CreativeApprovalService
    class AIInferenceGatewayService {
      +generateCaption(payload)
      +generateCreative(payload)
      +analyzeOmcsAgent(payload)
    }
    class LocalizedPromotionalContent <<Entity>>
    class ContentGenerationLog <<Entity>>
    class CreativeDirectionOutput <<Entity>>
    class CreativeDirectionLog <<Entity>>
  }

  package "FastAPI (fastapi-sbert)" #FFFDE7 {
    class CaptionRouter {
      +POST /internal/generation/caption
    }
    class CreativeRouter {
      +POST /internal/creative/generate
    }
    class ComplianceRouter {
      +POST /internal/omcs/analyze
    }
    class CaptionGenerationAgent <<LangGraph>> {
      +analyze_services(state)
      +generate_platform_captions(state)
    }
    class CulturalResearchService {
      +research_market(market)
    }
    class GeminiClient {
      +get_platform_guides(market)
      +generate_creative_direction(req)
    }
    class AgentLLMModel {
      +get_llm(): ChatGroq
    }
  }
}

' ── Frontend composition ──
ContentStudioView *-- AIContentMatrixPanel
ContentStudioView *-- VisualDirectionBoard
ContentStudioView *-- DistributionPanel
ContentStudioView *-- SmartOptimizationBoard
ContentStudioView *-- MediaCaptionManager
ContentStudioView --> apiClient
AIContentMatrixPanel *-- "3" CopywritingOptionCard
AIContentMatrixPanel *-- "3" PlatformTab
VisualDirectionBoard *-- "N" BlueprintStepItem
SmartOptimizationBoard *-- ComplianceGauge

' ── Frontend → Spring Boot ──
apiClient ..> ContentController : /api/v1/content/*
apiClient ..> CreativeDirectionController : /api/v1/creative-direction/*
apiClient ..> ComplianceController : /api/v1/compliance/omcs-analyze

' ── Spring Boot 3.1 ──
ContentController --> ContentGenerationService
ContentController --> ContentApprovalService
ContentGenerationService --> AIInferenceGatewayService : generateCaption()
ContentGenerationService --> LocalizedPromotionalContent
ContentGenerationService --> ContentGenerationLog
ContentApprovalService --> LocalizedPromotionalContent

' ── Spring Boot 3.2 (depends on 3.1 approval) ──
CreativeDirectionController --> CreativeDirectionService
CreativeDirectionController --> CreativeApprovalService
CreativeDirectionService --> ContentApprovalService : hasApprovedContent()
CreativeDirectionService --> AIInferenceGatewayService : generateCreative()
CreativeDirectionService --> CreativeDirectionOutput
CreativeDirectionService --> CreativeDirectionLog
CreativeApprovalService --> CreativeDirectionOutput

' ── Spring Boot 3.3 (stateless passthrough) ──
ComplianceController --> AIInferenceGatewayService : analyzeOmcsAgent()

' ── Spring Boot → FastAPI ──
AIInferenceGatewayService ..> CaptionRouter : POST /internal/generation/caption
AIInferenceGatewayService ..> CreativeRouter : POST /internal/creative/generate
AIInferenceGatewayService ..> ComplianceRouter : POST /internal/omcs/analyze

' ── FastAPI internals ──
CaptionRouter --> CaptionGenerationAgent
CaptionRouter --> GeminiClient : get_platform_guides()
CaptionGenerationAgent --> CulturalResearchService
CaptionGenerationAgent --> AgentLLMModel
CreativeRouter --> GeminiClient : generate_creative_direction()
GeminiClient --> AgentLLMModel

' ── Stack packages top-to-bottom ──
"React Frontend" -[hidden]down-> "Spring Boot"
"Spring Boot" -[hidden]down-> "FastAPI (fastapi-sbert)"

@enduml
