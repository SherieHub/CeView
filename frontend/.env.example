# Backend API base URL — defaults to http://localhost:8080 if unset.
VITE_API_BASE_URL=

# Set to "true" to serve fixture data for endpoints without a real backend
# yet, instead of hitting the network.
VITE_USE_FIXTURES=

# Firebase web app config — enables the "Continue with Google" button on the
# login page. Leave blank to leave it non-functional (the popup will fail).
# Get these from Firebase Console → Project Settings → your Web App. See
# RUNNING.md §6 "Google Sign-In setup" for the full walkthrough.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
