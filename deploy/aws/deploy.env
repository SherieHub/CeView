# Non-secret deployment settings, read by .github/workflows/deploy-aws.yml and
# shipped to the server in every release bundle. Secrets never go here: they
# live in SSM Parameter Store under /ceview/prod/ (docs/DEPLOY_AWS.md B9).
#
# Plain KEY=value lines only (no quotes, no spaces around =). The workflow
# refuses to run while any value still contains FILL_ME.

AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=410133709862
DOMAIN=ceview.online
SITE_BUCKET=ceview-prod-site-410133709862
OPS_BUCKET=ceview-prod-ops-410133709862
# CloudFront → your distribution → General tab, e.g. E1ABCDEF2GHIJK
CLOUDFRONT_DISTRIBUTION_ID=E2MGMAODXCEDZG
GITHUB_DEPLOY_ROLE_ARN=arn:aws:iam::410133709862:role/ceview-github-deploy
