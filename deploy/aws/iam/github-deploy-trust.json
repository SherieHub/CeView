{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsReleaseBranchOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::410133709862:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:SherieHub/CeView:ref:refs/heads/release"
        }
      }
    }
  ]
}
