# Production build settings for the React frontend. Copied to
# frontend/.env.production.local by the deploy workflow before `npm run build`.
# Everything here ends up in public JavaScript, so it must never hold a secret.
#
# The workflow refuses to build while any value still contains a placeholder, or if
# VITE_USE_FIXTURES is set to true.

VITE_API_BASE_URL=https://api.ceview.online

# Firebase Console → Project settings → General → Your apps → Web app config
# (RUNNING.md §6 "Google Sign-In setup" step 2).
VITE_FIREBASE_API_KEY=AIzaSyD9TYOE1ZSHjnjIqF9n6ZiC1JybqpBoiQc
VITE_FIREBASE_AUTH_DOMAIN=ceview-7e0ae.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ceview-7e0ae
VITE_FIREBASE_APP_ID=1:662063415962:web:08ba75c8966bd980281523

# Required before go-live (docs/DEPLOY_AWS.md A3): public pages for the privacy
# notice and terms. They can live anywhere, e.g. a Google Doc published to the web.
VITE_PRIVACY_URL=https://docs.google.com/document/d/e/2PACX-1vR9u_U4Sz1HTCqfvWvznQu7jM2AvhNp02_FNOh4XWlD68WPVzEaMMOhZ5nAiM9nldwALIaG5BHJSuWD/pub
VITE_TERMS_URL=https://docs.google.com/document/d/e/2PACX-1vSGxOPc9u-EWeGcpetR3EoJGseV_t8Q3unVeuYIaBoUU6Lr0MqRZZ6frNeJAC5tvFH0QL_dif_gt5He/pub 

# Optional. Blank means the landing page simply doesn't show that element.
VITE_CONTACT_EMAIL=
VITE_LEAD_FORM_ENDPOINT=
VITE_WALKTHROUGH_URL=
